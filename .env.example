# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# Source it (`set -a; . ./.env; set +a`) or export these before running.

# ---- API keys (set only the ones your axis needs; see REPRODUCE.md §4) ----
HF_TOKEN=                 # gated datasets, gated target models, gated local judges (HarmBench, Llama-Guard)
OAI_API=                 # OpenAI judges: sycophancy, refusal (StrongREJECT), prompt_injection
ANTHROPIC_API_KEY=       # Claude-haiku judges (honesty/faithfulness/bias/privacy/reward_hacking) + the AAR agent + integrity monitor

# ---- what to run ----
AXIS=honesty             # sycophancy|refusal|prompt_injection|power_seeking|honesty|faithfulness|bias|privacy|reward_hacking|concealing_uncertainty
MODEL=gemma              # qwen|llama|olmo|gemma|phi  (or a full HF id; see scripts/models.sh)
JUDGE_BACKEND=anthropic  # openai|anthropic|local — per-axis default in REPRODUCE.md §4

# ---- where things live (repo-relative defaults; override for your infra) ----
WORKSPACE_DIR=.                       # repo root; config.py derives most paths from this
AAR_REPO=.                            # used by scripts/axis/*.env for the briefing path
AAR_BENCHMARK_DOCS=./benchmark_docs   # publish_suite reads baselines from here
BENCHMARK_DOCS_DIR=./benchmark_docs   # run_eval reads the per-benchmark GOLDEN DECODING from here (keep both = benchmark_docs)
HARNESS_TRANSPORT=fs                  # fs (shared filesystem) | s3 (object store) — see PORTABILITY.md

# eval-only (keep reachable ONLY by the evaluator; see ISOLATION.md):
HOLDOUT_DIR=./_holdout
HELDOUT_SCORES_DIR=./_holdout/heldout_scores
# shared research<->eval handoff:
SUBMISSIONS_DIR=./_runs/submissions
SCORES_DIR=./_runs/scores

# ---- OPTIONAL: cloud backend (leave ALL empty to run locally / on your own infra) ----
# The built-in cloud path is RunPod (GPU pods) + S3 (transport); see PORTABILITY.md.
# Keep HARNESS_TRANSPORT=fs above and leave these empty to use a shared filesystem instead.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RUNPOD_API_KEY=
